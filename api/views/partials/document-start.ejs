<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <style>
    :root {
      color-scheme: light;
      --ink: #163028;
      --muted: #3e5c50;
      --line: #d5e4db;
      --paper: #f7fbf8;
      --card: #ffffff;
      --accent: #1f6b45;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 17px/1.65 Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    }
    header, main, footer { width: min(760px, calc(100% - 32px)); margin-inline: auto; }
    header { padding: 40px 0 8px; }
    .brand {
      margin: 0 0 8px;
      color: var(--accent);
      font: 700 13px/1.2 system-ui, sans-serif;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    h1 { margin: 0 0 8px; font-size: 2.1rem; line-height: 1.15; letter-spacing: -0.02em; }
    .updated { margin: 0; color: var(--muted); font: 15px/1.4 system-ui, sans-serif; }
    main { padding-bottom: 24px; }
    nav {
      margin: 28px 0;
      padding: 16px 18px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
    }
    nav ol { margin: 8px 0 0; padding-left: 1.2rem; }
    nav a { color: var(--accent); }
    section {
      margin: 0 0 18px;
      padding: 22px 22px 8px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
    }
    h2 { margin: 0 0 12px; font-size: 1.35rem; line-height: 1.25; }
    h3 { margin: 18px 0 6px; font-size: 1.05rem; }
    p, li { margin: 0 0 12px; }
    ul { margin: 0 0 12px; padding-left: 1.2rem; }
    a { color: var(--accent); }
    .clause { border-color: #b7d7c4; }
    footer {
      padding: 8px 0 40px;
      color: var(--muted);
      font: 14px/1.5 system-ui, sans-serif;
    }
  </style>
</head>
<body>
<header>
  <p class="brand"><%= appName %></p>
  <h1><%= title %></h1>
  <p class="updated">Obowiązuje od <%= updatedAt %></p>
</header>
<main>
