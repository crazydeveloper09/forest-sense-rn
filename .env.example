# Base URL of the backend proxy. On a physical phone, use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_AI_API_URL=http://YOUR_COMPUTER_LAN_IP:8787

# MongoDB used for accounts, two-factor secrets, and end-to-end encrypted observations.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=forest_sense

# 32-byte key for encrypting TOTP secrets at rest. Profile fields and observations stay encrypted
# on the device; the server cannot decrypt them. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Server-only Gemini key from Google AI Studio. Never prefix this with EXPO_PUBLIC_.
GEMINI_API_KEY=replace_with_a_new_server_side_key

# Optional
AI_API_PORT=8787
GEMINI_MODEL=gemini-3.8-flash

# Public HTTPS URL of the deployed API, used for Stripe return URLs and AdMob SSV.
PUBLIC_API_URL=https://api.example.com

# Server-only Stripe credentials from the Stripe Dashboard / Developers / Webhooks.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PREMIUM_TAX_CODE=txcd_10103100

# Generate a random secret of at least 32 characters for signed AdMob reward tokens.
ADMOB_SSV_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-replace_me/rewarded_unit_id

# Development only: permits claiming a Google test-ad reward from the local callback.
# Must remain false/unset in production; production rewards require AdMob SSV.
ALLOW_UNVERIFIED_AD_REWARDS=false

# Production mobile ad unit IDs; Google test units are used automatically in Expo dev.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-replace_me/banner_unit_id
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-replace_me/rewarded_unit_id
